  {
    "id": "table.trivia_sessions",
    "label": "Create table \"trivia_sessions\"",
    "summary": "Creates table \"trivia_sessions\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "table",
        "name": "trivia_sessions"
      }
    },
    "precheck": [
      {
        "description": "ensure table \"trivia_sessions\" does not exist",
        "sql": "SELECT (to_regclass($1)) IS NULL AS \"result\"",
        "params": [
          "\"public\".\"trivia_sessions\""
        ]
      }
    ],
    "execute": [
      {
        "description": "create table \"trivia_sessions\"",
        "sql": "CREATE TABLE \"public\".\"trivia_sessions\" (\n  \"completedAt\" timestamptz,\n  \"durationSeconds\" int4 NOT NULL,\n  \"expiresAt\" timestamptz NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"questionId\" int4,\n  \"quizId\" int4,\n  \"startedAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"userId\" int4 NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"trivia_session_completion_check_3e64cd05\" CHECK (\"completedAt\" IS NULL OR (\"completedAt\" >= \"startedAt\" AND \"completedAt\" <= \"expiresAt\")),\n  CONSTRAINT \"trivia_session_duration_check_92dcd0be\" CHECK ((\"questionId\" IS NOT NULL AND \"durationSeconds\" BETWEEN 10 AND 600) OR (\"quizId\" IS NOT NULL AND \"durationSeconds\" BETWEEN 30 AND 3600)),\n  CONSTRAINT \"trivia_session_expiry_check_d11bec3f\" CHECK (\"expiresAt\" > \"startedAt\"),\n  CONSTRAINT \"trivia_session_max_expiry_check_ba652e41\" CHECK (\"expiresAt\" <= \"startedAt\" + \"durationSeconds\" * INTERVAL '1 second'),\n  CONSTRAINT \"trivia_session_target_check_eb0b64e4\" CHECK ((\"questionId\" IS NOT NULL AND \"quizId\" IS NULL) OR (\"questionId\" IS NULL AND \"quizId\" IS NOT NULL))\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"trivia_sessions\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"trivia_sessions\""
        ]
      }
    ]
  },
